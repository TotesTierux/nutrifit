rules_version = '2';
// NutriFit – Firestore-Sicherheitsregeln
// Private Daten (Tagebuch, Training, Fasten, Gewohnheiten): nur die eigene Person.
// Familie (Essensplan, Einkaufsliste, Rezepte): nur Mitglieder. Beitritt nur mit gültigem Einladungscode.
service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function familyDoc(fid) { return get(/databases/$(db)/documents/families/$(fid)); }
    function isMemberOf(fid) { return signedIn() && request.auth.uid in familyDoc(fid).data.members; }

    // ---------- Persönliche Daten ----------
    match /users/{uid} {
      allow read, write: if signedIn() && request.auth.uid == uid;
      match /{rest=**} {
        allow read, write: if signedIn() && request.auth.uid == uid;
      }
    }

    // ---------- Familien ----------
    match /families/{fid} {
      function joinValid() {
        let code = request.resource.data.joinCode;
        let inv = /databases/$(db)/documents/invites/$(code);
        return code is string
          && exists(inv)
          && get(inv).data.fid == fid
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.auth.uid in request.resource.data.members
          && request.resource.data.owner == resource.data.owner
          && request.resource.data.name == resource.data.name;
      }

      allow get: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn()
        && request.resource.data.owner == request.auth.uid
        && request.resource.data.members == [request.auth.uid];
      // Mitglieder dürfen bearbeiten (z. B. austreten), der Besitzer bleibt gleich
      allow update: if signedIn() && (
          (request.auth.uid in resource.data.members && request.resource.data.owner == resource.data.owner)
          || joinValid()
        );
      allow delete: if signedIn() && resource.data.owner == request.auth.uid;

      // Essensplan, Einkaufsliste, Rezepte
      match /{coll}/{doc} {
        allow read, write: if isMemberOf(fid) && coll in ['plan', 'shop', 'recipes'];
      }
    }

    // ---------- Einladungscodes ----------
    match /invites/{code} {
      allow get: if signedIn();
      allow create: if isMemberOf(request.resource.data.fid) && request.resource.data.by == request.auth.uid;
      allow delete: if signedIn() && isMemberOf(resource.data.fid);
    }
  }
}
